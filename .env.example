# Таймаут HTTP-запроса, мс (через AbortController)
WEATHER_TIMEOUT_MS=5000

# Каталог для сохранения отчётов
WEATHER_REPORTS_DIR=reports

# Единицы измерения: metric (Цельсий, мм) | imperial (Фаренгейт, дюймы)
WEATHER_UNITS=metric

# Базовый URL геокодинга
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Базовый URL прогноза
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
